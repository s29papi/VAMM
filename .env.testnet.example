# Copy this file to `.env.testnet` and fill in the private keys before running the testnet scripts.

ALEOVEIL_TESTNET_ENDPOINT=https://api.explorer.provable.com/v2
ALEOVEIL_TESTNET_PRIVATE_KEY=

# Optional: use a separate proving/user key. Defaults to ALEOVEIL_TESTNET_PRIVATE_KEY.
ALEOVEIL_TESTNET_USER_PRIVATE_KEY=

# Optional: host/port for the local relayer wrapper used during testnet smoke tests.
ALEOVEIL_TESTNET_RELAYER_URL=http://127.0.0.1:4040
ALEOVEIL_TESTNET_RELAYER_BIND=127.0.0.1
ALEOVEIL_TESTNET_RELAYER_PORT=4040
